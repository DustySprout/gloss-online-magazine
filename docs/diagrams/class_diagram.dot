// Згенеровано build_class_diagram.py
digraph Classes {
  graph [rankdir=BT, fontname="DejaVu Sans", fontsize=26, labelloc=t, label="Діаграма класів: онлайн-журнал GLOSS (GoF-патерни позначено кольорами)\n ", nodesep=0.35, ranksep=0.7, pad=0.5, newrank=true, splines=true];
