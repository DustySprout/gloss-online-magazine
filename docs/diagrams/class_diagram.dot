    EventPublisher [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2e7d32" BGCOLOR="white"><TR><TD BGCOLOR="#c8e6c9" COLOR="#2e7d32"><FONT POINT-SIZE="10">«subject»</FONT><BR/><B>EventPublisher</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#2e7d32">-_observers: list<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#2e7d32">attach(o)<BR ALIGN="LEFT"/>detach(o)<BR ALIGN="LEFT"/>notify(event)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Observer [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2e7d32" BGCOLOR="white"><TR><TD BGCOLOR="#c8e6c9" COLOR="#2e7d32"><FONT POINT-SIZE="10">«abstract»</FONT><BR/><B><I>Observer</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#2e7d32"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#2e7d32">update(user, event, msg) «abstract»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    InAppObserver [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2e7d32" BGCOLOR="white"><TR><TD BGCOLOR="#c8e6c9" COLOR="#2e7d32"><B>InAppObserver</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#2e7d32"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#2e7d32">update()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    EmailObserver [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2e7d32" BGCOLOR="white"><TR><TD BGCOLOR="#c8e6c9" COLOR="#2e7d32"><B>EmailObserver</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#2e7d32"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#2e7d32">update()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    NotificationFactory [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#6d4c41" BGCOLOR="white"><TR><TD BGCOLOR="#d7b899" COLOR="#6d4c41"><B>NotificationFactory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#6d4c41"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#6d4c41">create(event): Message<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
