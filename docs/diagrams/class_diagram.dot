    Profile [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" BGCOLOR="white"><TR><TD BGCOLOR="#ffffff" COLOR="#555555"><B>Profile</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#555555">bio<BR ALIGN="LEFT"/>avatar<BR ALIGN="LEFT"/>recommendation_mode<BR ALIGN="LEFT"/>email_notifications<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" COLOR="#555555">for_user(user)<BR ALIGN="LEFT"/>is_premium: bool<BR ALIGN="LEFT"/>sees_ads: bool<BR ALIGN="LEFT"/>active_subscription<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
