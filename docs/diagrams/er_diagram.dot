    monetization_plan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#90a4ae"><TR><TD COLSPAN="3" BGCOLOR="#fff3e0"><B>monetization_plan</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#c2185b"><B>PK</B></FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(80)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="price" ALIGN="LEFT">price</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">decimal(8,2)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="duration_days" ALIGN="LEFT">duration_days</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="ad_free" ALIGN="LEFT">ad_free</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bool</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="exclusive_access" ALIGN="LEFT">exclusive_access</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bool</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
