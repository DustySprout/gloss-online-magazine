    monetization_partner [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#90a4ae"><TR><TD COLSPAN="3" BGCOLOR="#fff3e0"><B>monetization_partner</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#c2185b"><B>PK</B></FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(120)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="website" ALIGN="LEFT">website</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(200)</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
    monetization_adcampaign [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#90a4ae"><TR><TD COLSPAN="3" BGCOLOR="#fff3e0"><B>monetization_adcampaign</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#c2185b"><B>PK</B></FONT></TD></TR><TR><TD PORT="partner_id" ALIGN="LEFT">partner_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#c2185b"><B>FK</B></FONT></TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(150)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="is_promo" ALIGN="LEFT">is_promo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bool</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bool</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  }
