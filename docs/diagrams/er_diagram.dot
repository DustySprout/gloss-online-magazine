digraph ER {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=24, labelloc=t, nodesep=0.3, ranksep=1.1, pad=0.4,
         label="ER-діаграма бази даних magazine_db (MySQL, InnoDB, utf8mb4)\n "];
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge [color="#78909c", arrowhead=teetee, arrowtail=crowodot, dir=both, fontname="DejaVu Sans", fontsize=9];
  subgraph cluster_auth { label="Django auth"; fontsize=14; style="rounded,dashed"; color="#b0bec5";
    auth_user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#90a4ae"><TR><TD COLSPAN="3" BGCOLOR="#eceff1"><B>auth_user</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#c2185b"><B>PK</B></FONT></TD></TR><TR><TD PORT="username" ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(150)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#c2185b"><B>UQ</B></FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(254)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="password" ALIGN="LEFT">password</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(128)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="is_staff" ALIGN="LEFT">is_staff</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bool</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  }
